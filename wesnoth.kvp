Meta.DisplayName=Battle for Wesnoth (TeamKit)
Meta.Description=Serveur multijoueur officiel de Battle for Wesnoth (wesnothd 1.18, paquet Debian 13 wesnoth-1.18-server), qui accepte tous les clients 1.18.x, dont la version Steam actuelle (1.18.8). Le serveur n'apparait dans aucune liste publique : les joueurs passent par Multijoueur > Se connecter au serveur et tapent IP:port. Un seul port, 15000 en TCP. Joueurs connectes visibles dans AMP, console d'AMP branchee sur le serveur (help, msg, kick, ban).
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=NotSupported
Meta.Author=TeamKit
Meta.URL=https://github.com/hydrocut/AMPTemplates-Wesnoth
Meta.DisplayImageSource=steam:599390
Meta.EndpointURIFormat=
Meta.ConfigManifest=wesnothconfig.json
Meta.MetaConfigManifest=wesnothmetaconfig.json
Meta.ConfigRoot=wesnoth.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=wesnothd est installe depuis les depots Debian 13 (paquet wesnoth-1.18-server) a la creation du conteneur, par ExtraContainerPackages.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["wesnoth-1.18-server"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=e499e1b2-a540-5e13-b6cf-7fc54b8d4598
Meta.ImportableExtensions=[]
